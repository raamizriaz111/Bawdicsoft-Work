# ============================================================
# Universal Client Chatbot — Environment Configuration
# ============================================================

# Database Connection (PostgreSQL connection string; defaults to local sqlite if omitted)
# Example for Neon/Supabase: postgresql://username:password@ep-cool-lake.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Paste your client's Gemini API key here:
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Preferred Gemini Model
# Supported models: gemini-3.5-flash-lite, gemini-flash-lite-latest, gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Preferred Local Server Port (Default is 8002 to avoid conflict with BawdicSoft on 8001)
PORT=8002
